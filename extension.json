{
	"name": "Chatbot",
	"version": "0.7.0",
	"author": [
		"Simon Stier"
	],
	"url": "https://github.com/OpenSemanticWorld/mediawiki-extensions-Chatbot",
	"descriptionmsg": "chatbot-desc",
	"license-name": "AGPL v3",
	"type": "media",
	"AutoloadClasses": {
		"MediaWiki\\Extension\\Chatbot\\ApiChatbotToken": "includes/ApiChatbotToken.php",
		"MediaWiki\\Extension\\Chatbot\\ChatbotHooks": "Chatbot.hooks.php",
		"MediaWiki\\Extension\\Chatbot\\ChatbotPreferencesHooks": "Chatbot.hooks.php",
		"SpecialChatbot": "specials/SpecialChatbot.php"
	},
	"APIModules": {
		"chatbottoken": "MediaWiki\\Extension\\Chatbot\\ApiChatbotToken"
	},
	"config": {
		"ChatbotPopupAssistentConfig": {
				"value": {
					"iframe_src": false,
					"confirm_redirect": true
				},
				"description": "Configures the popup chat assistant. 'iframe_src' is the url of the chatbot backend to embed (false disables the assistant), 'confirm_redirect' asks the user before the assistant navigates to another page."
			},
		"ChatbotSecret": {
				"value": "",
				"description": "Secret shared with the chatbot backend (CHATBOT_SHARED_SECRET there). Used to sign the per-user token that action=chatbottoken issues. When empty no token is issued and the backend runs unauthenticated."
			},
		"ChatbotTokenTtl": {
				"value": 43200,
				"description": "Lifetime in seconds of the token issued by action=chatbottoken."
			},
		"ChatbotAllowedBackendOrigins": {
				"value": [],
				"description": "Origins a user may point the 'Custom backend for iframe' preference at, e.g. ['http://localhost:52670']. Empty disables the preference: it hands the full tool-call channel - including page content and file downloads - to whatever origin is entered."
			}
	},
	"ExtensionMessagesFiles": {
		"ChatbotAlias": "Chatbot.i18n.alias.php",
		"ChatbotMagic": "Chatbot.i18n.magic.php"
	},
	"Hooks": {
		"BeforePageDisplay": "MediaWiki\\Extension\\Chatbot\\ChatbotHooks::onBeforePageDisplay",
		"ResourceLoaderGetConfigVars": "MediaWiki\\Extension\\Chatbot\\ChatbotHooks::onResourceLoaderGetConfigVars",
		"ParserFirstCallInit": "MediaWiki\\Extension\\Chatbot\\ChatbotHooks::onParserFirstCallInit",
		"GetPreferences": "preferences_hooks"
	},
	"HookHandlers": {
		"preferences_hooks": {
			"class": "MediaWiki\\Extension\\Chatbot\\ChatbotPreferencesHooks",
			"services": [
				"MainConfig",
				"UserOptionsLookup"
			]
		}
	},
	"MessagesDirs": {
		"Chatbot": [
			"i18n"
		]
	},
	"ResourceModules": {
		"ext.chatbot": {
			"scripts": [
				"modules/ext.chatbot.js",
				"modules/ext.chatbot.foo.js"
			],
			"styles": [
				"modules/ext.chatbot.foo.css"
			],
			"messages": [],
			"dependencies": []
		},
		"ext.osw.ui.chatbot": {
			"localBasePath": "modules/ext.osw.ui.chatbot",
			"remoteExtPath": "Chatbot/modules/ext.osw.ui.chatbot",
			"dependencies": [
				"ext.OpenSemanticLab.forms",
				"mediawiki.api",
				"mediawiki.user"
			],
			"scripts": [
				"chatbot.js"
			],
			"styles": [
				"chatbot.css"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "Chatbot"
	},
	"SpecialPages": {
		"Chatbot": "SpecialChatbot"
	},
	"manifest_version": 2
}
